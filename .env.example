# 复制为 .env 后修改。生产环境必须使用独立的随机密钥和 HTTPS。
ADDR=127.0.0.1:8080
DB_PATH=data/comeet.db
RECORDING_DIR=data/recordings
# 按会议创建时间计算的最大时长；后台每 5 秒检查一次。
MEETING_MAX_MINUTES=240
LOG_FORMAT=text
JWT_SECRET=replace-this-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# 多个 ICE server 用逗号分隔。跨公网部署通常还需要 TURN。
VITE_STUN_URL=stun:stun.l.google.com:19302
# 如需 TURN，请配置自己的中继服务；VITE_ 变量会被打包到浏览器。
# 不要填入管理员密钥，正式环境应由后端签发短期 TURN 凭据。
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=temporary-user
# VITE_TURN_CREDENTIAL=temporary-credential

# 进阶档 SFU：先按 docs/进阶档.md 启动 LiveKit，再取消注释。
# 留空则使用兼容 P2P；SFU 的 Simulcast 与媒体端会控需要 LiveKit。
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_INTERNAL_URL=http://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=comeet-local-development-secret-2026

# 挑战档：本地 faster-whisper 或兼容 multipart 音频转写服务。
# STT_BASE_URL=http://127.0.0.1:8091/v1
STT_MODEL=tiny
# STT_API_KEY=your-stt-service-key
# DeepSeek 只负责会议纪要，不承担语音识别。密钥只放在后端。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_API_KEY=your-deepseek-key

