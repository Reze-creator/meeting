# 复制为 .env 后修改。生产环境必须使用独立的随机密钥和 HTTPS。
ADDR=127.0.0.1:8080
DB_PATH=data/comeet.db
JWT_SECRET=replace-this-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# 多个 ICE server 用逗号分隔。跨公网部署通常还需要 TURN。
VITE_STUN_URL=stun:stun.l.google.com:19302
# 如需 TURN，请配置自己的中继服务；VITE_ 变量会被打包到浏览器。
# 不要填入管理员密钥，正式环境应由后端签发短期 TURN 凭据。
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=temporary-user
# VITE_TURN_CREDENTIAL=temporary-credential

