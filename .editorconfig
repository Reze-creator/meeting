root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Windows PowerShell 5.1 需要 BOM 才能正确识别包含中文的 UTF-8 脚本。
[*.ps1]
charset = utf-8-bom
